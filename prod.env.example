# Mẫu cấu hình production. Trên server: cp prod.env.example prod.env && chmod 600 prod.env
# Mọi secret ở đây phải KHÁC môi trường test.

# --- Postgres (container postgres đọc 3 biến này khi khởi tạo DB lần đầu) ---
POSTGRES_USER=appdist
POSTGRES_PASSWORD=
POSTGRES_DB=appdist
# Host là tên service "postgres" trong docker-compose.yml. Mật khẩu có ký tự đặc biệt thì URL-encode.
DB_SOURCE=postgresql://appdist:<POSTGRES_PASSWORD>@postgres:5432/appdist?sslmode=disable

HTTP_SERVER_ADDRESS=0.0.0.0:8080

# Domain HTTPS của BE (Nginx + Let's Encrypt) — iOS chỉ cài qua HTTPS có chứng chỉ hợp lệ.
DOMAIN=https://api.dist.example.com
# Domain web FE — link trang tải <FRONTEND_URL>/d/<token>, QR và link mời trỏ về đây.
FRONTEND_URL=https://dist.example.com
CORS_ALLOWED_ORIGINS=https://dist.example.com

# Đúng 32 ký tự: openssl rand -hex 16
TOKEN_SYMMETRIC_KEY=
ACCESS_TOKEN_DURATION=60m
REFRESH_TOKEN_DURATION=720h

# Backblaze B2 — nên dùng bucket và application key riêng cho production.
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

MAX_UPLOAD_SIZE_MB=1024

SWAGGER_ENABLED=false
