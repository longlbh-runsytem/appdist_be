DB_SOURCE=postgresql://root:secret@localhost:5432/appdist?sslmode=disable
HTTP_SERVER_ADDRESS=0.0.0.0:8080

# URL public (HTTPS) của BE mà điện thoại của khách gọi thẳng — dùng để tạo nút
# Cài đặt, manifest.plist, link file .ipa/.apk. DOMAIN có thì ghi đè PUBLIC_BASE_URL.
# iOS chỉ cài được qua HTTPS có chứng chỉ hợp lệ (domain thật hoặc ngrok/cloudflared).
PUBLIC_BASE_URL=http://localhost:8080
DOMAIN=https://dist.example.com

# Gốc của web FE — link trang tải (<FRONTEND_URL>/d/<token>, cả trong QR) và link mời
# (<FRONTEND_URL>/accept-invite?token=...) trỏ về đây. Bỏ trống = dùng PUBLIC_BASE_URL.
FRONTEND_URL=

# Origin của web FE được gọi API (CORS), phân tách bằng dấu phẩy. "*" = mọi origin (chỉ dùng khi dev).
# Bỏ trống = chỉ FRONTEND_URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Đúng 32 ký tự.
TOKEN_SYMMETRIC_KEY=
ACCESS_TOKEN_DURATION=60m
REFRESH_TOKEN_DURATION=720h

# Backblaze B2 (S3-compatible). Xem README mục "Cấu hình Backblaze B2".
# Endpoint KHÔNG có https://, region là phần giữa endpoint.
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Dung lượng tối đa 1 file upload (MB).
MAX_UPLOAD_SIZE_MB=1024

# Swagger UI tại /swagger/index.html — nên tắt ở production.
SWAGGER_ENABLED=true

# make seed / service seed của compose: tạo tài khoản demo khi DB còn trống. Production để false.
SEED_DEMO_DATA=true
